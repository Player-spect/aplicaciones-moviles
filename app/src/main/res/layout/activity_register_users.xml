<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_gris_0">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registrar un usuario"
                android:textSize="18sp"
                android:textColor="@color/bg_gris_80"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <EditText
                android:id="@+id/etCrudNombres"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/editbox_background"
                android:hint="NOMBRES"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/etCrudApellidos"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/editbox_background"
                android:hint="APELLIDOS"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/etCrudEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/editbox_background"
                android:hint="E-MAIL"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/etCrudClave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/editbox_background"
                android:hint="CLAVE"
                android:inputType="textPassword"
                android:padding="12dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnGuardarCrud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GUARDAR USUARIO"
                android:backgroundTint="@color/bg_muni"
                android:textColor="@color/bg_gris_0"
                android:paddingHorizontal="32dp"/>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>