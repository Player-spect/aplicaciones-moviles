<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gris_0"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/img"
            android:layout_marginBottom="12dp" />

        <!-- Fecha y Hora Actual -->
        <TextClock
            android:id="@+id/tvFechaHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="'Fecha/Hora: 'dd-MM-yyyy, HH:mm:ss"
            android:format24Hour="'Fecha/Hora: 'dd-MM-yyyy, HH:mm:ss"
            android:textSize="14sp"
            android:textColor="@color/bg_gris_70"
            android:layout_marginBottom="32dp" />

        <!-- Opción 1: CRUD Usuario -->
        <Button
            android:id="@+id/btnCrudUsuario"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="CRUD USUARIO"
            android:backgroundTint="@color/bg_gris_0"
            android:textColor="@color/bg_muni"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            style="?attr/materialButtonOutlinedStyle"
            app:strokeColor="@color/bg_muni"
            app:strokeWidth="2dp"/>

        <!-- Opción 2: Datos Sensor -->
        <Button
            android:id="@+id/btnDatosSensor"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="DATOS SENSOR"
            android:backgroundTint="@color/bg_gris_0"
            android:textColor="@color/bg_muni"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            app:strokeColor="@color/bg_muni"
            app:strokeWidth="2dp"/>

        <!-- Portafolio -->
        <Button
            android:id="@+id/btnDesarrollador"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="PORTAFOLIO"
            android:backgroundTint="@color/bg_gris_0"
            android:textColor="@color/bg_muni"
            android:textSize="14sp"
            android:textStyle="bold"
            app:strokeColor="@color/bg_muni"
            app:strokeWidth="2dp"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>