<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gris_0"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/img"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GESTIÓN DE USUARIOS"
            android:textSize="18sp"
            android:textColor="@color/bg_gris_80"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <!-- Registrar -->
        <Button
            android:id="@+id/btnCrearUsuarioCrud"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="REGISTRAR NUEVO USUARIO"
            android:backgroundTint="@color/bg_muni"
            android:textColor="@color/bg_gris_0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Listar -->
        <Button
            android:id="@+id/btnListarUsuarios"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="LISTAR Y ADMINISTRAR USUARIOS"
            android:backgroundTint="@color/bg_gris_0"
            android:textColor="@color/bg_muni"
            android:textSize="14sp"
            android:textStyle="bold"
            app:strokeColor="@color/bg_muni"
            app:strokeWidth="2dp"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>